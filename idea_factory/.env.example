# Idea Factory - Environment Variables
# Copy to .env and adjust

# LLM Provider: ollama | openai (default: ollama)
LLM_PROVIDER=ollama

# --- Ollama (when LLM_PROVIDER=ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_ID=gpt-oss:20b

# --- OpenAI (when LLM_PROVIDER=openai) ---
# OPENAI_API_KEY is required when using OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Django ---
# Optional: set absolute path to db.sqlite3 if running from different directories
# IDEA_FACTORY_DB=/full/path/to/idea_factory/db.sqlite3
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
