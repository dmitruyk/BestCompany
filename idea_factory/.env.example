# Idea Factory - Environment Variables
# Copy to .env and adjust

# LLM Provider: ollama | openai (default: ollama)
LLM_PROVIDER=ollama

# --- Ollama (when LLM_PROVIDER=ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_ID=gpt-oss:20b

# --- OpenAI (when LLM_PROVIDER=openai) ---
# OPENAI_API_KEY is required when using OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Django ---
DJANGO_SECRET_KEY=your-secret-key-here

# --- PostgreSQL ---
DB_HOST=192.168.0.230
DB_PORT=5440
DB_NAME=idea_factory
DB_USER=postgres
DB_PASSWORD=your-password-here
DJANGO_DEBUG=true
# Production behind Synology reverse proxy (manage.addmylegacy.com → container :8089):
# DJANGO_DEBUG=false
DJANGO_PUBLIC_HOST=manage.addmylegacy.com
DJANGO_BEHIND_REVERSE_PROXY=true
CSRF_TRUSTED_ORIGINS=https://manage.addmylegacy.com
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.230,192-168-0-230.dmitruyk.direct.quickconnect.to,.dmitruyk.direct.quickconnect.to,manage.addmylegacy.com
