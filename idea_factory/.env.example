# Idea Factory - Environment Variables
# Copy to .env and adjust

# LLM Provider: ollama | openai (default: ollama)
LLM_PROVIDER=ollama

# --- Ollama (when LLM_PROVIDER=ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL_ID=gpt-oss:20b

# --- OpenAI (when LLM_PROVIDER=openai) ---
# OPENAI_API_KEY is required when using OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# --- Django ---
DJANGO_SECRET_KEY=your-secret-key-here

# --- PostgreSQL ---
DB_HOST=192.168.0.230
DB_PORT=5440
DB_NAME=idea_factory
DB_USER=postgres
DB_PASSWORD=your-password-here
DJANGO_DEBUG=true
# Production behind Synology reverse proxy (manage.addmylegacy.com → container :8089):
# DJANGO_DEBUG=false
DJANGO_PUBLIC_HOST=manage.addmylegacy.com
DJANGO_BEHIND_REVERSE_PROXY=true
CSRF_TRUSTED_ORIGINS=https://manage.addmylegacy.com
ALLOWED_HOSTS=localhost,127.0.0.1,192.168.0.230,192-168-0-230.dmitruyk.direct.quickconnect.to,.dmitruyk.direct.quickconnect.to,manage.addmylegacy.com

# --- Google Calendar (optional) ---
# Create OAuth Web client in Google Cloud Console; redirect URI:
# https://YOUR_HOST/settings/google-calendar/callback/
# GOOGLE_CALENDAR_CLIENT_ID=
# GOOGLE_CALENDAR_CLIENT_SECRET=
# GOOGLE_CALENDAR_DEFAULT_REMINDERS=60,1440

# --- Company activity ticker (Docker service idea-factory-ticker) ---
# TICKER_ENABLED=true
# TICKER_INTERVAL_SECONDS=3600
# TICKER_WEEKLY_PLANNING=true
# TICKER_WEEKLY_PLANNING_HOUR=8
# TICKER_STALE_PLANNING_HOURS=2
# TICKER_TASK_EXECUTION=true
# TICKER_TASK_MAX_PER_COMPANY=2
# TICKER_TASK_AUTONOMOUS_ONLY=false
